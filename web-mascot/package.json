{
  "name": "web-mascot",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Embeddable browser mascot engine (NeurolingsCE-Qt web port)",
  "keywords": [
    "mascot",
    "shimeji",
    "desktop-pet",
    "browser",
    "vue"
  ],
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/types/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./mascot_pack": "./dist/mascot_pack",
    "./mascot_pack/*": "./dist/mascot_pack/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "vue-tsc && vite build && tsc -p tsconfig.lib.json",
    "dev:test-host": "vite --config vite.test-host.config.ts",
    "types": "tsc -p tsconfig.lib.json",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
