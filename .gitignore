# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物 ----------
dist/
dist-ssr/
*.local
.vite/
coverage/
*.tsbuildinfo
dist-extension/
release/
web-mascot/dist-extension/
web-mascot/release/
web-mascot/*.tgz
web-mascot/store-assets/
store-assets/

# ---------- 测试资产与临时文件 ----------
test-assets/

# ---------- 运行时日志 ----------
# 宠物运行产生的分目录日志、录制文件
logs/
# 录制器默认落盘位置（vite.config.ts 的 mascotLog.logRoot），
# 与仓库根的 logs/ 是两个不同目录，需要各自忽略
web-mascot/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 调试工具产物 ----------
# 浏览器自动化工具的页面快照与控制台导出
.playwright-cli/

# ---------- 环境变量 ----------
.env
.env.*
!.env.example

# ---------- 第三方源码检出 ----------
# NeurolingsCE-Qt 是上游仓库的独立克隆
# （remote: https://github.com/qingchenyouforcc/NeurolingsCE-Qt.git），
# 由该仓库自行维护，不纳入本仓库版本管理。
external/

# ---------- 编辑器与系统文件 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
